#!/usr/sbin/nft -f
# Template baseline isolasi VLAN Tamu (10.10.0.0/16) <-> VLAN Media/TV (10.20.0.0/16).
# Pasangan IP Tamu <-> IP Receiver TV yang terotorisasi dimasukkan secara dinamis
# oleh Inaply Gateway ke dalam set `authorized_cast_pairs`.

table inet inaply {
    set authorized_cast_pairs {
        type ipv4_addr . ipv4_addr
        flags timeout
    }

    set cast_tcp_ports {
        type inet_service
        elements = { 7000, 7100, 8008, 8009, 8443 }
    }

    set cast_udp_ports {
        type inet_service
        elements = { 50000-50100 }
    }

    chain forward {
        type filter hook forward priority filter; policy accept;

        ct state established,related accept

        # Izinkan trafik dari HP tamu ke TV kamar HANYA jika ada di authorized_cast_pairs
        ip saddr . ip daddr @authorized_cast_pairs tcp dport @cast_tcp_ports accept
        ip saddr . ip daddr @authorized_cast_pairs udp dport @cast_udp_ports accept

        # Blokir seluruh trafik langsung lain dari VLAN Tamu ke VLAN Media/TV
        ip saddr 10.10.0.0/16 ip daddr 10.20.0.0/16 drop
    }
}
