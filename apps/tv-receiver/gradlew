#!/usr/bin/env bash
set -euo pipefail

GRADLE_VERSION="8.5"
WRAPPER_DIR="${HOME}/.gradle/wrapper/dists/gradle-${GRADLE_VERSION}-bin"
GRADLE_BIN="${WRAPPER_DIR}/gradle-${GRADLE_VERSION}/bin/gradle"

if [ ! -x "${GRADLE_BIN}" ]; then
  mkdir -p "${WRAPPER_DIR}"
  TMP_ZIP="${WRAPPER_DIR}/gradle-${GRADLE_VERSION}-bin.zip"
  curl -fsSL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o "${TMP_ZIP}"
  unzip -q -o "${TMP_ZIP}" -d "${WRAPPER_DIR}"
  rm -f "${TMP_ZIP}"
fi

exec "${GRADLE_BIN}" "$@"
